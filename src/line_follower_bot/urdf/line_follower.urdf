<?xml version="1.0"?>
<robot name="ir_line_follower">

  <!-- ==================== MATERIALS ==================== -->
  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.9 0.1 0.1 1.0"/>
  </material>

  <!-- ==================== BASE FOOTPRINT ==================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- ==================== CHASSIS (140mm x 120mm x 30mm) ==================== -->
  <!-- Strictly within the 150mm x 150mm x 40mm limit -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.12 0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.12 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0006375" ixy="0.0" ixz="0.0"
               iyy="0.0008542" iyz="0.0"
               izz="0.0014167"/>
    </inertial>
  </link>

  <!-- ==================== LEFT DRIVE WHEEL ==================== -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.015"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <inertia ixx="0.0000244" ixy="0.0" ixz="0.0"
               iyy="0.0000244" iyz="0.0"
               izz="0.000045"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.03 0.0675 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== RIGHT DRIVE WHEEL ==================== -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.015"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <inertia ixx="0.0000244" ixy="0.0" ixz="0.0"
               iyy="0.0000244" iyz="0.0"
               izz="0.000045"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.03 -0.0675 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== 1 FRONT CASTER WHEEL ==================== -->
  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0000045" ixy="0.0" ixz="0.0"
               iyy="0.0000045" iyz="0.0"
               izz="0.0000045"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.045 0.0 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- Low friction for passive caster wheel so it glides without dragging -->
  <gazebo reference="caster_wheel">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- ==================== 3 IR SENSORS (LEFT, CENTER, RIGHT) ==================== -->
  <!-- 1. Left IR Sensor Link -->
  <link name="ir_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.005 0.005 0.005"/>
      </geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <!-- Pitch = 1.570796 rad (90 deg) points the IR beam straight down at the floor -->
  <joint name="ir_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ir_left_link"/>
    <origin xyz="0.065 0.054 -0.015" rpy="0 1.570796 0"/>
  </joint>

  <!-- 2. Center IR Sensor Link -->
  <link name="ir_center_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.005 0.005 0.005"/>
      </geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="ir_center_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ir_center_link"/>
    <origin xyz="0.065 0.0 -0.015" rpy="0 1.570796 0"/>
  </joint>

  <!-- 3. Right IR Sensor Link -->
  <link name="ir_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.005 0.005 0.005"/>
      </geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="ir_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ir_right_link"/>
    <origin xyz="0.065 -0.054 -0.015" rpy="0 1.570796 0"/>
  </joint>

  <!-- ==================== GAZEBO IR SENSOR DEFINITIONS ==================== -->
  <!-- Single-beam IR ray sensors pointed straight down -->
  <gazebo reference="ir_left_link">
    <sensor name="ir_left" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/ir_left</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.001</min>
          <max>0.10</max>
          <resolution>0.0001</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

  <gazebo reference="ir_center_link">
    <sensor name="ir_center" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/ir_center</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.001</min>
          <max>0.10</max>
          <resolution>0.0001</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

  <gazebo reference="ir_right_link">
    <sensor name="ir_right" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/ir_right</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.001</min>
          <max>0.10</max>
          <resolution>0.0001</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

  <!-- ==================== GAZEBO DIFF DRIVE & JOINT STATE PLUGINS ==================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.135</wheel_separation>
      <wheel_radius>0.03</wheel_radius>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
